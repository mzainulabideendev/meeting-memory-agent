# --- LLM ---------------------------------------------------------------------
# Leave blank to run without a generative LLM (deterministic extractive mode)
GEMINI_API_KEY=
LLM_PROVIDER=auto
LLM_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# Optional OpenAI-compatible endpoint (gateway, vLLM, Ollama, ...)
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Optional local HuggingFace model. First run downloads the weights.
LOCAL_LLM_ENABLED=false
LOCAL_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct

# --- Embeddings --------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu

# --- Storage -----------------------------------------------------------------
CHROMA_PATH=storage/chroma
DATABASE_PATH=storage/meetings.db

# --- Retrieval ---------------------------------------------------------------
CHUNK_TARGET_TOKENS=520
CHUNK_MAX_TOKENS=700
CHUNK_OVERLAP_TOKENS=80
VECTOR_TOP_K=12
KEYWORD_TOP_K=12
MAX_EVIDENCE_CHUNKS=24
MAX_RESEARCH_LOOPS=2
ENABLE_CROSS_ENCODER_RERANK=false

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
